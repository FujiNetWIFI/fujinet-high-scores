[Unit]
Description=CoCo Demon Attack Hi-scores
After=remote-fs.target
After=syslog.target

# replace paths to match your TNFS directory and web root

[Service]
User=root
Group=root
ExecStart=/usr/local/sbin/coco-demonattack "/tnfs/coco/DEMONATTACK-HS.DSK" "/var/www/html/coco-demonattack.html"

[Install]
WantedBy=multi-user.target
